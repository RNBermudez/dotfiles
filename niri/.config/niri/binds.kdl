binds {
    // Applications & Utilities
    Mod+Space repeat=false hotkey-overlay-title="Application Launcher" {
        spawn-sh "noctalia msg panel-toggle launcher"
    }
    Mod+Return repeat=false hotkey-overlay-title="Open Ghostty" {
        spawn "ghostty" "+new-window"
    }
    Mod+Y repeat=false hotkey-overlay-title="Open Yazi" {
        spawn "ghostty" "+new-window" "-e" "yazi"
    }
    Mod+C repeat=false hotkey-overlay-title="Open Calculator" {
        spawn-sh "noctalia msg panel-toggle yuuto/calculator:panel"
    }
    Mod+N repeat=false hotkey-overlay-title="Open a new note on Neovim" {
        spawn-sh "ghostty +new-window -e nvim ~/docs/note-$(date +%Y-%m-%d-%H%M%S).txt"
    }
    Mod+Shift+N repeat=false hotkey-overlay-title="Notifications" {
        spawn-sh "noctalia msg panel-toggle control-center notifications"
    }
    Mod+V repeat=false hotkey-overlay-title="Clipboard Manager" {
        spawn-sh "noctalia msg panel-toggle clipboard"
    }
    Mod+Shift+Y repeat=false hotkey-overlay-title="Browse Wallpapers" {
        spawn-sh "noctalia msg panel-toggle wallpaper"
    }
    Mod+M repeat=false hotkey-overlay-title="Task Manager" {
        spawn-sh "noctalia msg panel-toggle control-center system"
    }
    Mod+Comma repeat=false hotkey-overlay-title="Settings" {
        spawn-sh "noctalia msg settings-toggle"
    }
    XF86Tools repeat=false hotkey-overlay-title="Settings" {
        spawn-sh "noctalia msg settings-toggle"
    }
    // Window & Column Focus
    Mod+H hotkey-overlay-title="Focus Column Left" {
        focus-column-left
    }
    Mod+L hotkey-overlay-title="Focus Column Right" {
        focus-column-right
    }
    Mod+K hotkey-overlay-title="Focus Window Up" {
        focus-window-up
    }
    Mod+J hotkey-overlay-title="Focus Window Down" {
        focus-window-down
    }
    Mod+Home hotkey-overlay-title="Focus Column First" {
        focus-column-first
    }
    Mod+End hotkey-overlay-title="Focus Column Last" {
        focus-column-last
    }
    Mod+T hotkey-overlay-title="Switch Focus Between Floating And Tiling" {
        switch-focus-between-floating-and-tiling
    }
    // Window & Column Movement
    Mod+Shift+H hotkey-overlay-title="Move Window Left" {
        move-column-left
    }
    Mod+Shift+L hotkey-overlay-title="Move Window Right" {
        move-column-right
    }
    Mod+Shift+K hotkey-overlay-title="Move Window Up" {
        move-window-up
    }
    Mod+Shift+J hotkey-overlay-title="Move Window Down" {
        move-window-down
    }
    Mod+Shift+Home hotkey-overlay-title="Move Column To First" {
        move-column-to-first
    }
    Mod+Shift+End hotkey-overlay-title="Move Column To Last" {
        move-column-to-last
    }
    Mod+BracketLeft hotkey-overlay-title="Consume Or Expel Window Left" {
        consume-or-expel-window-left
    }
    Mod+BracketRight hotkey-overlay-title="Consume Or Expel Window Right" {
        consume-or-expel-window-right
    }
    Mod+Period hotkey-overlay-title="Expel Window From Column" {
        expel-window-from-column
    }
    // Window Layout & Sizing
    Mod+Q repeat=false hotkey-overlay-title="Close Window" {
        close-window
    }
    Mod+F hotkey-overlay-title="Maximize Column" {
        maximize-column
    }
    Mod+Shift+F hotkey-overlay-title="Toggle Window Fullscreen" {
        fullscreen-window
    }
    Mod+Ctrl+F hotkey-overlay-title="Expand Column To Available Width" {
        expand-column-to-available-width
    }
    Mod+Shift+Ctrl+F hotkey-overlay-title="Expand Column To Available Width" {
        maximize-window-to-edges
    }
    Mod+Shift+T hotkey-overlay-title="Toggle Window Floating" {
        toggle-window-floating
    }
    Mod+backslash hotkey-overlay-title="Toggle Column Tabbed Display" {
        toggle-column-tabbed-display
    }
    Mod+E hotkey-overlay-title="Switch Preset Column Height" {
        switch-preset-window-height
    }
    Mod+Shift+E hotkey-overlay-title="Switch Preset Window Height" {
        switch-preset-window-height-back
    }
    Mod+Ctrl+E hotkey-overlay-title="Reset Window Height" {
        reset-window-height
    }
    Mod+R hotkey-overlay-title="Switch Preset Column Width" {
        switch-preset-column-width
    }
    Mod+Shift+R hotkey-overlay-title="Switch Preset Window Width" {
        switch-preset-column-width-back
    }
    Mod+Equal hotkey-overlay-title="Increase Window Width by 10%" {
        set-column-width "+10%"
    }
    Mod+Minus hotkey-overlay-title="Decrease Window Width By 10%" {
        set-column-width "-10%"
    }
    Mod+Shift+Equal hotkey-overlay-title="Increase Window Height By 10%" {
        set-window-height "+10%"
    }
    Mod+Shift+Minus hotkey-overlay-title="Decrease Window Height By 10%" {
        set-window-height "-10%"
    }
    Mod+W hotkey-overlay-title="Center Column" {
        center-column
    }
    Mod+Shift+W hotkey-overlay-title="Center Visible Columns" {
        center-visible-columns
    }
    // Workspace Management
    Mod+1 hotkey-overlay-title="Focus Workspace 1" {
        focus-workspace 1
    }
    Mod+2 hotkey-overlay-title="Focus Workspace 2" {
        focus-workspace 2
    }
    Mod+3 hotkey-overlay-title="Focus Workspace 3" {
        focus-workspace 3
    }
    Mod+4 hotkey-overlay-title="Focus Workspace 4" {
        focus-workspace 4
    }
    Mod+5 hotkey-overlay-title="Focus Workspace 5" {
        focus-workspace 5
    }
    Mod+6 hotkey-overlay-title="Focus Workspace 6" {
        focus-workspace 6
    }
    Mod+7 hotkey-overlay-title="Focus Workspace 7" {
        focus-workspace 7
    }
    Mod+8 hotkey-overlay-title="Focus Workspace 8" {
        focus-workspace 8
    }
    Mod+9 hotkey-overlay-title="Focus Workspace 9" {
        focus-workspace 9
    }
    Mod+Shift+1 hotkey-overlay-title="Move Column to Workspace 1" {
        move-column-to-workspace 1
    }
    Mod+Shift+2 hotkey-overlay-title="Move Column to Workspace 2" {
        move-column-to-workspace 2
    }
    Mod+Shift+3 hotkey-overlay-title="Move Column to Workspace 3" {
        move-column-to-workspace 3
    }
    Mod+Shift+4 hotkey-overlay-title="Move Column to Workspace 4" {
        move-column-to-workspace 4
    }
    Mod+Shift+5 hotkey-overlay-title="Move Column to Workspace 5" {
        move-column-to-workspace 5
    }
    Mod+Shift+6 hotkey-overlay-title="Move Column to Workspace 6" {
        move-column-to-workspace 6
    }
    Mod+Shift+7 hotkey-overlay-title="Move Column to Workspace 7" {
        move-column-to-workspace 7
    }
    Mod+Shift+8 hotkey-overlay-title="Move Column to Workspace 8" {
        move-column-to-workspace 8
    }
    Mod+Shift+9 hotkey-overlay-title="Move Column to Workspace 9" {
        move-column-to-workspace 9
    }
    Mod+U hotkey-overlay-title="Focus Workspace Down" {
        focus-workspace-down
    }
    Mod+I hotkey-overlay-title="Focus Workspace Up" {
        focus-workspace-up
    }
    Mod+Ctrl+U hotkey-overlay-title="Move Workspace Down" {
        move-workspace-down
    }
    Mod+Ctrl+I hotkey-overlay-title="Move Workspace Up" {
        move-workspace-up
    }
    Mod+Shift+U hotkey-overlay-title="Move Column To Workspace Down" {
        move-column-to-workspace-down
    }
    Mod+Shift+I hotkey-overlay-title="Move Column To Workspace Up" {
        move-column-to-workspace-up
    }
    // Monitor Management
    Mod+Ctrl+H hotkey-overlay-title="Focus Monitor Left" {
        focus-monitor-left
    }
    Mod+Ctrl+L hotkey-overlay-title="Focus Monitor Right" {
        focus-monitor-right
    }
    Mod+Ctrl+K hotkey-overlay-title="Focus Monitor Up" {
        focus-monitor-up
    }
    Mod+Ctrl+J hotkey-overlay-title="Focus Monitor Down" {
        focus-monitor-down
    }
    Mod+Shift+Ctrl+H hotkey-overlay-title="Move Column To Monitor Left" {
        move-column-to-monitor-left
    }
    Mod+Shift+Ctrl+L hotkey-overlay-title="Move Column To Monitor Right" {
        move-column-to-monitor-right
    }
    Mod+Shift+Ctrl+K hotkey-overlay-title="Move Column To Monitor Up" {
        move-column-to-monitor-up
    }
    Mod+Shift+Ctrl+J hotkey-overlay-title="Move Column To Monitor Down" {
        move-column-to-monitor-down
    }
    // Media & Hardware Controls
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Decrease Audio Volume" {
        spawn-sh "noctalia msg volume-down"
    }
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Increase Audio Volume" {
        spawn-sh "noctalia msg volume-up"
    }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Toggle Audio Mute" {
        spawn-sh "noctalia msg volume-mute"
    }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Toggle Mic Mute" {
        spawn-sh "noctalia msg mic-mute"
    }
    Ctrl+XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Decrease Player Volume" {
        spawn-sh "noctalia msg mic-volume-down"
    }
    Ctrl+XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Increase Player Volume" {
        spawn-sh "noctalia msg mic-volume-up"
    }
    XF86AudioNext allow-when-locked=true hotkey-overlay-title="Player Next" {
        spawn-sh "noctalia msg media next"
    }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Player Previous" {
        spawn-sh "noctalia msg media previous"
    }
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Player Play/Pause" {
        spawn-sh "noctalia msg media toggle"
    }
    XF86AudioPause allow-when-locked=true hotkey-overlay-title="Player Play/Pause" {
        spawn-sh "noctalia msg media toggle"
    }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Decrease Brightness" {
        spawn-sh "noctalia msg brightness-down"
    }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Increase Brightness" {
        spawn-sh "noctalia msg brightness-up"
    }
    // Screenshots
    Print repeat=false hotkey-overlay-title="Screenshot (Area)" {
        screenshot
    }
    XF86Launch1 repeat=false hotkey-overlay-title="Screenshot (Area)" {
        screenshot
    }
    Ctrl+Print repeat=false hotkey-overlay-title="Screenshot (Screen)" {
        screenshot-screen
    }
    Ctrl+XF86Launch1 repeat=false hotkey-overlay-title="Screenshot (Screen)" {
        screenshot-screen
    }
    Alt+Print repeat=false hotkey-overlay-title="Screenshot (Window)" {
        screenshot-window
    }
    Alt+XF86Launch1 repeat=false hotkey-overlay-title="Screenshot (Window)" {
        screenshot-window
    }
    // Session & System
    Mod+G repeat=false hotkey-overlay-title="Toggle Overview" {
        toggle-overview
    }
    Mod+Shift+Slash hotkey-overlay-title="Show Hotkey Overlay" {
        show-hotkey-overlay
    }
    Mod+Escape allow-inhibiting=false hotkey-overlay-title="Toggle Keyboard Shortcuts Inhibit" {
        toggle-keyboard-shortcuts-inhibit
    }
    Mod+X repeat=false hotkey-overlay-title="Lock Screen" {
        spawn-sh "noctalia msg session lock"
    }
    Mod+Shift+Q repeat=false hotkey-overlay-title="Power Menu: Toggle" {
        spawn-sh "noctalia msg panel-toggle session"
    }
    Mod+Shift+X repeat=false hotkey-overlay-title="Power Off Monitors" {
        power-off-monitors
    }
    Mod+Shift+Ctrl+Q repeat=false hotkey-overlay-title="Quit Niri" {
        quit
    }
}
